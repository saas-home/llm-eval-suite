# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / packaging artifacts
build/
dist/
*.egg-info/

# Test & linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
htmlcov/

# Environments & Configs
.venv/
env/
venv/
ENV/
.env
.env.local
*.env
config.json
!config.json.example
!.env.example

# Local logs
*.log

# Ad-hoc analysis / review / deployment reports (not shipped docs)
SERVER*-REPORT.md
CROSS-REPO-REVIEW-*.md
REVIEW-*.md

# Output Results (Keep template comparison reports, ignore ad-hoc evaluation dumps)
results/*.json
results/*.md
!results/.gitkeep
!results/samples/
!results/samples/*.md

# Tooling sandboxes (pi / agent runtime)
.pi/
sandbox/

# OS artifacts
.DS_Store
Thumbs.db
