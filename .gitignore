# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / packaging artifacts
build/
dist/
*.egg-info/
*.egg

# Test, coverage & linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/

# Environments & Configs
.venv/
env/
venv/
ENV/
.env
.env.*
*.env
config.json
!config.json.example
!.env.example

# Local logs & debug dumps
*.log
*.tmp
*.temp

# Editor & IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.#*

# AI & Tooling sandboxes
.pi/
.gemini/
.cursor/
.claude/
sandbox/

# Ad-hoc analysis / review / deployment reports (not shipped docs)
SERVER*-REPORT.md
CROSS-REPO-REVIEW-*.md
REVIEW-*.md

# Output Results (Keep samples and .gitkeep, ignore all generated benchmark dumps to prevent leaking IPs/keys)
results/*
!results/.gitkeep
!results/samples/
!results/samples/**

# OS artifacts
.DS_Store
Thumbs.db
